# dependencies
node_modules/

# build + cdk output
dist/
*.js
*.d.ts
!eslint.config.mjs
# hand-written type shims under src are source, not compiled output
!src/**/*.d.ts
cdk.out/
*.tsbuildinfo
# the static demo is a build artifact, regenerated by `npm run demo:static` and
# published by the pages workflow, so it is not committed
demo/static/

# downloaded public datasets, prepared images and raw model runs. Fetched by
# npm run data:fetch and checked against pinned sha256 sums, never committed.
.cache/

# test + coverage
coverage/
.vitest/

# eval run outputs are regenerated by `npm run eval`. The kept prompt comparison
# lives alongside them and is committed.
eval/results/*.json
# The v2 results are the exception. CI rebuilds them from eval/v2/data and fails
# if they drift, so they have to be committed to have something to compare with.
!eval/results/stp.json
!eval/results/calibration.json
!eval/results/routing.json
!eval/results/perturbation.json

# local env + secrets. Nothing long-lived AWS ever lands here.
.env
.env.local
*.pem

# editor / OS
.DS_Store
.idea/
.vscode/
*.log

# local assistant and agent scratch. Tooling config and build notes that are
# personal to a machine, not part of the project.
.claude/
.agents/
.codex/
Docket_DIRECTIVE.md
docket_PLAN.md
comment_instruction.md
NOTES.md

# cdk context cache can leak account ids
cdk.context.json
